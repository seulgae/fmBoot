<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check / 기타 CVE 스캐너용 suppression 정의.

  이 파일은 "실제로 이 프로젝트에서 취약 코드 경로가 로드되지 않음"이 근거일 때만 예외 처리한다.
  근본 해결(버전 상향)은 Spring Boot 3 이관 작업으로 별도 진행한다.

  사용법:
    mvn org.owasp:dependency-check-maven:check \
        -DsuppressionFile=dependency-check-suppressions.xml
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      CVE-2025-22235 (CVSS 7.3)
      Spring Boot EndpointRequest.to() 가 비노출 Actuator 엔드포인트에 대해 잘못된 Security 매처를 생성.

      프로젝트 적용 판정: Not Exploitable
        - spring-boot-starter-actuator 의존성 미포함
        - WebSecurityConfig 등에서 EndpointRequest 사용 없음
        - 즉, 취약 코드 경로가 classpath에 로드되지 않음
      재평가 시점: Spring Boot 3.x 이관 작업 시 본 suppression 제거
    -->
    <suppress>
        <notes><![CDATA[
            Not exploitable: actuator not on classpath, EndpointRequest not used.
            Remove this suppression when migrating to Spring Boot 3.x.
        ]]></notes>
        <cve>CVE-2025-22235</cve>
    </suppress>

</suppressions>